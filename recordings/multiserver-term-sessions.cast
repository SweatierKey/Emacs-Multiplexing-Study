[26.7696, "o", "\u001b[34;1H\u001b[?25l\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mwiden                  \u001b[3m\u001b[90mRemove all narrowing criteria.          \u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90m          \u001b[0m\u001b[39;49m\u001b[24;3H\u001b[38;5;20m26  \u001b[39;49m\r\n\u001b[38;5;20m\u001b[48;5;157mterm-sessions-list\u001b[39;49m\u001b[48;5;157m                        \u001b[39;49m\u001b[3m\u001b[90m\u001b[48;5;157mList active zmx sessions across local and currently open TRAMP r…\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mmode                   \u001b[3m\u001b[90mMajor mode for listing persistent terminal sessions.             \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mnarrow-name            \u001b[3m\u001b[90mNarrow to sessions whose name match\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90mes REGEXP.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mnarrow-remote          \u001b[3m\u001b[90mNarrow to remote sessio\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90mns.       \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mrevert                 \u001b[3m\u001b[90mRefresh and reprint the current term ses\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90msion list.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mnarrow-command         \u001b[3m\u001b[90mNarrow to sessions whose foreground/start command matches REGEXP.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mstore-org-link         \u001b[3m\u001b[90mStore or copy Org links for selected sessions.                   \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mmark-regexp            \u001b[3m\u001b[90mMark visible sessions whose name or command matches REGEXP.      \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mterm-sessions-list\u001b[39;49m\u001b[1m-\u001b[0mnarrow-attached        \u001b[3m\u001b[90mNarrow to sessions with one or more attached clients.            \u001b[0m\u001b[39;49m\u001b[24;30H\u001b[?12l\u001b[?25h\u001b[?12;25h"]
