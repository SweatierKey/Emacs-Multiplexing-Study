[27.3398, "o", "\u001b[1;33H\u001b[?25l\u001b[7mHelp        \u001b[0m\u001b[39;49m\u001b[27m\u001b[17;1H\u001b[38;5;236m\u001b[47m-UUU:**-  F1  \u001b[39;49m\u001b[1m\u001b[38;5;236m\u001b[47m*term-session:fleet-db: ~/Emacs-Multiplexing-Study*\u001b[0m\u001b[39;49m\u001b[38;5;236m\u001b[47m   Top   L14    (Term: line run) --------------------------------\u001b[39;49m\r\n\u001b[4m\u001b[30m\u001b[48;5;250m  Name\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m               \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mWhere\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m          \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mProject\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m   \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mCreated\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m          \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mUpdated\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m          \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mClients\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mCwd\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m                \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250mCommand\u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m            \u001b[0m\u001b[39;49m\u001b[4m\u001b[30m\u001b[48;5;250m    \u001b[0m\u001b[39;49m\r\n\u001b[48;5;157m  fleet-db           local          Emacs-Mu… 2026-09-26 15:15 2026-09-26 15:15 1       /home/admin/Emacs… /usr/bin/ssh -F /home/\u001b[39;49m$\r\n\u001b[C\u001b[Cfleet-web          local          Emacs-Mu… 2026-09-26 15:15 2026-09-26 15:15 1       /home/admin/Emacs… /usr/bin/ssh -F /home/$\r\n\n\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[30m\u001b[48;5;250m-UUU:%%-  F1  \u001b[39;49m\u001b[1m\u001b[30m\u001b[48;5;250m*term-sessions*\u001b