[16.2879, "o", "\u001b[32;1H\u001b[?25l\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0msend-ctrl-slash                     \u001b[3m\u001b[90mSend ‘C-’ to the libvterm.                             \u001b[0m\u001b[39;49m\u001b[22;3H\u001b[38;5;20m42  \u001b[39;49m\r\n\u001b[38;5;20m\u001b[48;5;157mvterm\u001b[39;49m\u001b[48;5;157m                                     \u001b[39;49m\u001b[3m\u001b[90m\u001b[48;5;157mCreate an interactive Vterm buffer.                    \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0msend-ctrl-delete \u001b[38;5;129m(C-<delete>)\u001b[39;49m       \u001b[3m\u001b[90mSend ‘C-<delete>’ to the libvterm.                     \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0myank-primary \u001b[38;5;129m(<mouse-2>)\u001b[39;49m            \u001b[3m\u001b[90mYank text from the primary selection\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90m in vterm.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0mnext-prompt \u001b[38;5;129m(C-c C-n)\u001b[39;49m               \u001b[3m\u001b[90mMove to end of Nth next prompt in t\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90mhe buffer.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0mxterm-paste \u001b[38;5;129m(<xterm-paste>)\u001b[39;49m         \u001b[3m\u001b[90mHandle xterm paste EVENT\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90m in vterm.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0m-self-insert-meta \u001b[38;5;129m(M-~)\u001b[39;49m\u001b[K\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0myank \u001b[38;5;129m(C-y)\u001b[39;49m                          \u001b[3m\u001b[90mYank (paste) text in vterm.                            \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0msend-tab \u001b[38;5;129m(TAB)\u001b[39;49m                      \u001b[3m\u001b[90mSend ‘<tab>’ to the l\u001b[0m\u001b[39;49m\u001b[10@\u001b[3m\u001b[90mibvterm.  \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm\u001b[39;49m\u001b[1m-\u001b[0msend-next-key                       \u001b[3m\u001b[90mRead next input event and send it to the libvterm.     \u001b[0m\u001b[39;49m\u001b[22;21H\u001b[?12l\u001b[?25h\u001b[?12;25h"]
