[2.9237, "o", "\u001b[32;1H\u001b[K\u001b[22;3H\u001b[?25l\u001b[38;5;20m9   \u001b[39;49m\r\n\u001b[38;5;20m\u001b[48;5;157mmulti-vterm\u001b[39;49m\u001b[48;5;157m                     \u001b[39;49m\u001b[3m\u001b[90m\u001b[48;5;157mCreate new vterm buffer.                               \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mproject             \u001b[3m\u001b[90mCreate new vterm buffer.                               \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mnext                \u001b[3m\u001b[90mGo to the next term buffer.                 \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mdedicated-open      \u001b[3m\u001b[90mOpen dedicated ‘multi-vterm’ window.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mrename-buffer       \u001b[3m\u001b[90mRename vterm buffer to NAME.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mdedicated-select    \u001b[3m\u001b[90mSelect the ‘multi-vterm’ dedicated window.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mprev                \u001b[3m\u001b[90mGo to the previous term buffer.                        \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mdedicated-close     \u001b[3m\u001b[90mClose dedicated ‘multi-vterm’ window.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mmulti-vterm\u001b[39;49m\u001b[1m-\u001b[0mdedicated-toggle    \u001b[3m\u001b[90mToggle dedicated ‘multi-vterm’ window.                 \u001b[0m\u001b[39;49m\u001b[22;23H\u001b[?12l\u001b[?25h\u001b[?12;25h"]
