[2.6236, "o", "\u001b[32;1H\u001b[K\u001b[22;3H\u001b[?25l\u001b[38;5;20m8   \u001b[39;49m\r\n\u001b[38;5;20m\u001b[48;5;157mvterm-toggle\u001b[39;49m\u001b[48;5;157m                    \u001b[39;49m\u001b[3m\u001b[90m\u001b[48;5;157mVterm toggle.                                          \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mshow               \u001b[3m\u001b[90mShow the vterm buffer.                                 \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mcd-show            \u001b[3m\u001b[90mSwitch to an idle vterm buffer and insert a cd command.\u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mbackward           \u001b[3m\u001b[90mGo to the previous term buffer.  \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mhide               \u001b[3m\u001b[90mHide the vterm buffer. \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mforward            \u001b[3m\u001b[90mGo to the next term buffer.       \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0mcd                 \u001b[3m\u001b[90mVterm toggle and insert a cd command.                  \u001b[0m\u001b[39;49m\r\n\u001b[38;5;20mvterm-toggle\u001b[39;49m\u001b[1m-\u001b[0minsert-cd          \u001b[3m\u001b[90mCd to the directory where your previous buffer file ex…\u001b[0m\u001b[39;49m\r\n\u001b[K\u001b[22;24H\u001b[?12l\u001b[?25h\u001b[?12;25h"]
