[6.3255, "o", "\u001b[2d\u001b[?25lC-t 3    split current tmux pane horizontally\r\nC-t 2    split current tmux pane vertically\r\nC-t c    create a new tmux window\r\nC-t S    create a new detached tmux session\r\nC-t t    open the tmux manager\r\nC-t k    kill the current tmux pane\r\nq    Quit the current manager/help window\u001b[16;6H\u001b[38;5;236m\u001b[47m%*-  F1  \u001b[39;49m\u001b[1m\u001b[38;5;236m\u001b[47m*tmux-control-help*\u001b[0m\u001b[39;49m\u001b[38;5;236m\u001b[47m   Bot   L28    (Special) --------\u001b[39;49m\r\n\u001b[4mPanes \u001b[0m       \r\n* ops              @0     %0     bash             109x29\u001b[K\r\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\n\u001b[K\n\u001b[K\n\n\u001b[K\n\u001b[K\n\t\t\t\t\b\u001b[30m\u001b[48;5;250mBot   L11\u001b[39;49m\u001b[17;1H\u001b[?12l\u001b[?25h\u001b[?12;25h"]
